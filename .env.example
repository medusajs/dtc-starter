# ============================================
# Medusa DTC Starter - Combined Environment
# ============================================
# This file serves as the single source of truth for all environment variables.
# Copy to .env for local development or use in production deployment.
# cp .env.example .env
#
# For Docker Compose:
#   Local:    docker compose up --build -d
#   Production: docker compose -f docker-compose.prod.yml up -d

# ============================================
# Database
# ============================================
# PostgreSQL connection string (mandatory)
#   Local Docker:  postgres://postgres:postgres@postgres:5432/medusa-store
#   Dockploy/VPS:  postgres://user:password@host:5432/dbname
DATABASE_URL=postgres://postgres:postgres@postgres:5432/medusa-store

# Database name (used by Postgres container setup)
DB_NAME=medusa-store

# Enable SSL for database connection (set to "true" for cloud Postgres like RDS)
DATABASE_SSL=false

# ============================================
# Redis (for caching, events, workflows, locking)
# ============================================
#   Local Docker:  redis://redis:6379
#   Dockploy/VPS:  redis://user:password@host:6379
REDIS_URL=redis://redis:6379
CACHE_REDIS_URL=redis://redis:6379
LOCKING_REDIS_URL=redis://redis:6379

# ============================================
# Backend (Medusa Server)
# ============================================
# Node environment
NODE_ENV=production

# Server port
PORT=9000

# Medusa worker mode: "server" | "worker" | "shared"
MEDUSA_WORKER_MODE=server

# Backend URL (used by admin dashboard)
MEDUSA_BACKEND_URL=http://localhost:9000

# Disable admin dashboard UI
DISABLE_MEDUSA_ADMIN=false

# Seed the database on first start (set to "true" to seed)
MEDUSA_SEED=false

# CORS origins (comma-separated)
STORE_CORS=http://localhost:8000
ADMIN_CORS=http://localhost:9000
AUTH_CORS=http://localhost:9000

# Secrets - CHANGE THESE IN PRODUCTION!
JWT_SECRET=supersecret
COOKIE_SECRET=supersecret

# ============================================
# Storefront (Next.js)
# ============================================
# Publishable API key (generate from Medusa Admin)
NEXT_PUBLIC_MEDUSA_PUBLISHABLE_KEY=

# Medusa backend URL (must be accessible from the browser)
NEXT_PUBLIC_MEDUSA_BACKEND_URL=http://localhost:9000

# Default region/country code
NEXT_PUBLIC_DEFAULT_REGION=dk

# Base public URL of the storefront
NEXT_PUBLIC_BASE_URL=http://localhost:8000

# Stripe publishable key (optional, for Stripe payments)
NEXT_PUBLIC_STRIPE_KEY=

# ============================================
# Object Storage (optional)
# ============================================
# Medusa Cloud S3 / S3-compatible storage
MEDUSA_CLOUD_S3_HOSTNAME=
MEDUSA_CLOUD_S3_PATHNAME=

# ============================================
# Docker Image Configuration
# (Used by docker-compose.prod.yml)
# ============================================
# GHCR image references (override to use custom tags)
# BACKEND_IMAGE=ghcr.io/shubashbiswas/dtc-starter-backend
# STOREFRONT_IMAGE=ghcr.io/shubashbiswas/dtc-starter-storefront
# IMAGE_TAG=latest

# Port mapping for production deploy
# BACKEND_PORT=9000
# STOREFRONT_PORT=8000